{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRT Paper",
  "version": "0.1.1",
  "identifier": "org.grt.paper",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GRT Paper",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "GRT Project",
    "shortDescription": "Local word processor",
    "longDescription": "Writes and typesets documents entirely offline, saving them in an inspectable container that records nothing about who made it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/etc/apparmor.d/usr.bin.grt-paper": "apparmor/usr.bin.grt-paper"
        },
        "postInstallScript": "apparmor/postinst",
        "postRemoveScript": "apparmor/postrm"
      }
    }
  }
}
