{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the editor and the presenter view: no network and no shell.",
  "windows": [
    "main",
    "presenter"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "core:webview:deny-create-webview",
    "core:webview:deny-create-webview-window",
    "core:window:deny-create"
  ]
}
