# SPDX-License-Identifier: MIT
# AppArmor profile for grt-grid.
#
# What is being confined is not really the application, it is WebKitGTK
# underneath it: a browser engine with a JIT, parsing documents that came from
# somewhere else. That is the attack the people who use this actually face.
#
# The first rule is the one that matters. grt-grid has no network feature, so it has
# no business opening a socket, and this says so rather than trusting that it
# never will.
abi <abi/3.0>,

include <tunables/global>

profile grt-grid /usr/bin/grt-grid {
  include <abstractions/base>
  include <abstractions/X>
  include <abstractions/fonts>
  include <abstractions/freedesktop.org>
  include <abstractions/dbus-session-strict>
  include <abstractions/mesa>
  # mesa identifies the GPU from the PCI device's uevent, vendor and device
  # files. Refused, it cannot tell what it is driving and falls back to the CPU;
  # in a virtual machine that looks like working, which is why it was only seen
  # once the test stopped truncating the list of denials.
  include <abstractions/dri-enumerate>
  include <abstractions/nameservice>
  include <abstractions/openssl>

  deny network inet,
  deny network inet6,
  deny network netlink raw,
  deny network packet,

  /usr/bin/grt-grid mr,
  /usr/share/grt-grid/{,**} r,
  /usr/share/applications/{,*} r,
  /usr/share/icons/{,**} r,
  /usr/share/mime/{,**} r,
  /usr/share/glib-2.0/schemas/{,*} r,

  /usr/libexec/webkit2gtk-4.1/* ix,
  /usr/lib/@{multiarch}/webkit2gtk-4.1/** mr,
  # Debian keeps WebKit's helper processes here, not in /usr/libexec, so the
  # /usr/libexec line above matches nothing on this distribution. With mr alone
  # the libraries loaded and the processes that use them were refused: exec of
  # WebKitNetworkProcess denied, measured in a booted image under enforcement.
  /usr/lib/@{multiarch}/webkit2gtk-4.1/WebKit*Process ix,

  # Three reads WebKit makes on every start, each refused until they were
  # listed here, each measured in a booted image under enforcement:
  #
  # libglvnd looks up the EGL vendor libraries in these two directories. Refused,
  # EGL does not initialise and WebKit falls back to software rendering — which
  # in a virtual machine looks exactly like working, and on a real laptop is
  # every page drawn by the CPU.
  /usr/share/glvnd/egl_vendor.d/{,*} r,
  /etc/glvnd/egl_vendor.d/{,*} r,
  # The memory-pressure monitor reads zoneinfo, and JavaScriptCore reads the
  # lowest address it may map. Neither says anything about the person.
  @{PROC}/zoneinfo r,
  @{PROC}/sys/vm/mmap_min_addr r,
  # mesa keeps compiled shaders here; refused, every start recompiles them.
  owner @{HOME}/.cache/mesa_shader_cache{,_db}/{,**} rwk,
  # Whether this is a laptop or a desktop, which GLib and WebKit ask once at
  # start. One of a handful of values, and the program has no network to send it
  # anywhere.
  /sys/devices/virtual/dmi/id/chassis_type r,
  /sys/firmware/acpi/pm_profile r,
  /usr/bin/bwrap ix,

  # Tauri derives its directories from the application identifier, so these are
  # org.grt.grid and not grt-grid. Getting that wrong does not fail loudly: the program
  # starts, finds no settings and no notes, and looks as though it had never
  # been used.
  # The directories those live in, created when they do not exist yet, and
  # only the directories: a rule ending in / grants nothing inside it.
  #
  # Without these, a program started where ~/.local does not exist dies before
  # its window opens. Tauri creates ~/.local/share/<identifier> with
  # create_dir_all, the mkdir of ~/.local is refused, and the process panics
  # with "Failed to setup app: Permission denied (os error 13)". That is what
  # all nine did the first time they ran under this profile in a booted image.
  owner @{HOME}/.local/ w,
  owner @{HOME}/.local/share/ w,
  owner @{HOME}/.local/state/ w,
  owner @{HOME}/.config/ w,
  owner @{HOME}/.cache/ w,

  owner @{HOME}/.config/org.grt.grid/{,**} rwk,
  owner @{HOME}/.cache/org.grt.grid/{,**} rwk,
  owner @{HOME}/.local/share/org.grt.grid/{,**} rwk,
  owner @{HOME}/.local/state/org.grt.grid/{,**} rwk,

  # By their XDG names rather than their English ones: on an Italian desktop the
  # folder is ~/Documenti, and a profile that names ~/Documents confines a
  # program to a directory that does not exist. The tunables define these as
  # Documents and Downloads, and the image adds the localised names beside them
  # in tunables/xdg-user-dirs.d.
  owner @{HOME}/@{XDG_DOCUMENTS_DIR}/{,**} rwk,
  owner @{HOME}/@{XDG_DOWNLOAD_DIR}/{,**} rwk,

  deny @{HOME}/.ssh/{,**} rwklx,
  deny @{HOME}/.gnupg/{,**} rwklx,
  deny @{HOME}/.mozilla/{,**} rwklx,
  deny @{HOME}/.config/grt-sentry/{,**} rwklx,

  # Opening something in whatever the person uses for it. This deliberately
  # leaves the confinement — the handler is their video player or browser, and
  # it is not this profile's business to constrain it. Ux rather than Px
  # because there is no profile to hand it to.
  /usr/bin/xdg-open Ux,
  /usr/bin/xdg-mime rix,
  /usr/bin/gio Ux,

  # File dialogs go through the XDG desktop portal on the session bus, and
  # dbus-session-strict allows the connection but no traffic. Without these,
  # import and export silently do nothing.
  dbus send bus=session path=/org/freedesktop/portal/{desktop,documents}
       interface=org.freedesktop.portal.*
       peer=(name=org.freedesktop.portal.Desktop),
  dbus receive bus=session path=/org/freedesktop/portal/{desktop,documents}
       interface=org.freedesktop.portal.*
       peer=(name=org.freedesktop.portal.Desktop),
  dbus send bus=session path=/org/freedesktop/DBus
       interface=org.freedesktop.DBus
       member={Hello,GetNameOwner,NameHasOwner,AddMatch,RemoveMatch}
       peer=(name=org.freedesktop.DBus),
  # The portal hands back a file descriptor for what the person picked, and the
  # document store is where it lives.
  owner /run/user/@{uid}/doc/{,**} rw,

  /dev/dri/* rw,
  /sys/devices/**/drm/** r,
  /sys/bus/pci/devices/ r,
  /sys/devices/system/cpu/{,**} r,
  /sys/fs/cgroup/** r,

  @{PROC}/@{pid}/{cmdline,stat,statm,status,maps,mountinfo,cgroup} r,
  @{PROC}/sys/kernel/random/boot_id r,
  @{PROC}/sys/vm/overcommit_memory r,
  owner /run/user/@{uid}/{,**} rw,
  owner /tmp/{,**} rw,
  owner /dev/shm/** rw,
}
